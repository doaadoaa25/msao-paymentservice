# ---------- Service ----------
PORT=8086
NODE_ENV=development
DB_PATH=./data/shipping.db

# ---------- CORS (frontend Vite) ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Communication inter-services : Orders ----------
# true  : Shipping vérifie la commande (existence, statut PAID, propriétaire)
#         et synchronise le statut de la commande (SHIPPED / DELIVERED).
# false : mode autonome (aucun appel sortant) — utile pour tester Shipping seul.
ORDERS_INTEGRATION=true
ORDERS_URL=http://localhost:8084
ORDERS_TIMEOUT_MS=4000
# true  : Shipping met à jour le statut de la commande (SHIPPED / DELIVERED) — recommandé.
# false : Shipping ne touche pas à la commande (à utiliser si Orders refuse un PATCH vers
#         le statut déjà en place ET que le frontend synchronise lui-même la commande).
ORDERS_SYNC_STATUS=true

# ---------- Authentification ----------
# off    : aucune vérification (le frontend en mode mock envoie des faux tokens)
# jwt    : vérifie le JWT localement avec JWT_SECRET (même secret que le service Auth)
# remote : appelle GET {AUTH_URL}/api/auth/me avec le token reçu
AUTH_MODE=off
JWT_SECRET=change-me
AUTH_URL=http://localhost:8081
AUTH_TIMEOUT_MS=4000
