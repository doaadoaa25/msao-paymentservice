{
  "name": "msoa-shipping-service",
  "version": "1.0.0",
  "description": "MSOA E-commerce — Shipping microservice (REST, Node.js + Express + SQLite)",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "start:solo": "node src/server.js --standalone",
    "dev": "node --watch src/server.js",
    "db:reset": "node src/db/reset.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
